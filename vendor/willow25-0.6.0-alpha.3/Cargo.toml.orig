[package]
name = "willow25"
version = "0.6.0-alpha.3"
edition = "2024"
description = "A ready-to-use implementation of the Willow specifications."
homepage = "https://willowprotocol.org/rust/"
repository = "https://codeberg.org/worm-blossom/willow_rs"
license = "MIT OR Apache-2.0"

[dependencies]
anyhash = "0.1.3"
async-fs = "2.2.0"
bab_rs = "0.8.0"
base32 = "0.5.1"
base64 = "0.22.1"
compact_u64 = { workspace = true }
const-hex = { version = "1.17.0", default-features = false }
constant_time_eq = { version = "0.4.2", default-features = false }
derive_more = { workspace = true, features = ["display", "error"] }
ed25519-dalek = { version = "2.2.0", features = ["rand_core"] }
fjall = "3.0.3"
frugal_async = "0.1.0"
hifitime = { version = "4.2.2", default-features = false }
meadowcap = { path = "../meadowcap", version = "0.5.0" }
order_theory = "0.1.6"
rand_core = "0.6.4"
signature = "2.2.0"
ufotofu = { workspace = true }
willow-data-model = { path = "../willow_data_model", version = "0.7.0" }
willow25-macros = { path = "../willow25_macros", version = "0.1.0" }

# Dependencies when enabling the `dev` feature:
arbitrary = { version = "1.0.2", features = ["derive"], optional = true }

# Depend on `futures-lite` for `zip` combinator when enabling `drop_format`:
futures-lite = {version = "1.4.2", optional = true}

[dev-dependencies]
pollster = "0.4.0"
rand = "0.8.0"

[features]
default = ["std", "drop_format"]
dev = [
  "bab_rs/dev",
  "dep:arbitrary",
  "meadowcap/dev",
  "std",
  "willow-data-model/dev",
]
drop_format = ["std", "futures-lite"]
std = ["hifitime/std", "willow-data-model/std", "ufotofu/std"]

[lints]
workspace = true
