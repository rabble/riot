{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riot.protest.net/release/schemas/toolchains.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "versionCommand", "checksumKind", "sha256", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "versionCommand": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "checksumKind": { "enum": ["artifact", "normalized-version-output"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source": { "type": "string", "minLength": 1 },
          "downloadUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "downloadChecksum": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "enum": ["sha1", "sha256"] },
              "value": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
            },
            "allOf": [
              {
                "if": { "properties": { "algorithm": { "const": "sha1" } } },
                "then": { "properties": { "value": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } }
              },
              {
                "if": { "properties": { "algorithm": { "const": "sha256" } } },
                "then": { "properties": { "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
              }
            ]
          }
        },
        "dependentRequired": {
          "downloadUrl": ["downloadChecksum"],
          "downloadChecksum": ["downloadUrl"]
        },
        "allOf": [
          {
            "if": { "properties": { "checksumKind": { "const": "artifact" } } },
            "then": {
              "properties": {
                "downloadUrl": true,
                "downloadChecksum": true
              },
              "required": ["downloadUrl", "downloadChecksum"]
            }
          }
        ]
      }
    }
  }
}
