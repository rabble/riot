{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riot.protest.net/release/schemas/network-matrix.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "initiator", "destinationClass", "transmittedFields", "redirectHandling", "retention", "developerOperated", "developerRetention", "userDirected", "platformCodePaths"],
        "properties": {
          "id": { "enum": ["first-launch", "denied-permission", "granted-permission", "nearby-sync", "followed-site-refresh"] },
          "initiator": { "type": "string", "minLength": 1 },
          "destinationClass": { "type": "string", "minLength": 1 },
          "transmittedFields": { "type": "array", "items": { "type": "string" } },
          "redirectHandling": { "type": "string", "minLength": 1 },
          "retention": { "type": "string", "minLength": 1 },
          "developerOperated": { "type": "boolean" },
          "developerRetention": { "enum": ["none", "peer-local", "destination-controlled"] },
          "userDirected": { "type": "boolean" },
          "platformCodePaths": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ios", "ipados", "macos", "android"],
            "properties": {
              "ios": { "$ref": "#/$defs/codePaths" },
              "ipados": { "$ref": "#/$defs/codePaths" },
              "macos": { "$ref": "#/$defs/codePaths" },
              "android": { "$ref": "#/$defs/codePaths" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "codePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
