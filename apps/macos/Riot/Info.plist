<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- REQUIRED by App Store submission: the archive is rejected outright
	     ("The Info.plist must contain a LSApplicationCategoryType key") without
	     it. Must be a real UTI from Apple's category list, not free text. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Find nearby Riot phones you choose to connect with.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_riot-sync._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect directly to a nearby Riot phone without using the internet.</string>
</dict>
</plist>
